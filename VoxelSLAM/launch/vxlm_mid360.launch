<launch>
	<arg name="rviz" default="true" />
	<arg name="debug" default="false" />

	<rosparam command="load" file="$(find voxel_slam)/config/mid360.yaml"/>
	<param name="finish" value="false"/>
	<group unless="$(arg debug)">
		<node pkg="voxel_slam" type="voxelslam" name="voxelslam" output="screen"/>
	</group>
	<group if="$(arg debug)">
		<node pkg="voxel_slam" type="voxelslam" name="voxelslam" output="screen"
			launch-prefix="xterm -e gdb -ex run --args"/>
	</group>
  
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find voxel_slam)/rviz_cfg/back.rviz" />
	</group>
	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/mvs/image raw out:=/mvs/image" output="screen" respawn="true"/>
     
</launch>